<?xml version="1.0" encoding="utf-8"?>
<!--
  IBM i Turnover — all settings live here (read by the app at startup; IIS Manager shows them under
  "Application Settings" and "Connection Strings").
  Order of precedence, later wins: appsettings.json < web.config < environment variables < Azure Key Vault.
  Secrets (passwords, client secrets) do NOT belong here: turn on KeyVault:Enabled and store them as secrets,
  named with two hyphens where the setting has a colon: "ConnectionStrings", two hyphens, "Db2Prod" holds the
  whole connection string; "AzureAd", two hyphens, "ClientSecret" holds the Entra client secret.
-->
<configuration>
  <appSettings>
    <!-- Sample = built-in demo catalog. Live = read IBM i catalogs and deploy over ODBC. -->
    <add key="Turnover:Mode" value="Sample" />
    <add key="Turnover:DataDirectory" value="App_Data" />

    <!-- Login: Windows (IIS / AD groups), EntraId (Microsoft sign-in page) or Demo (Development only). -->
    <add key="Turnover:Auth:Mode" value="Windows" />
    <!-- Windows: AD group names. EntraId: group object ids (or define app roles named Developer / Approver / ReleaseManager). -->
    <add key="Turnover:RoleGroups:Developer:0" value="CORP\TOV-Developers" />
    <add key="Turnover:RoleGroups:Approver:0" value="CORP\TOV-Approvers" />
    <add key="Turnover:RoleGroups:ReleaseManager:0" value="CORP\TOV-ReleaseManagers" />
    <add key="Turnover:ApprovalsRequired" value="1" />
    <add key="Turnover:ProdApprovalsRequired" value="2" />
    <add key="Turnover:AllowBlockerOverrideBelowProd" value="true" />

    <!-- Environments. Libraries/Profiles: LOGICAL=PHYSICAL pairs; the logical name is how the same thing is matched across environments. -->
    <add key="Turnover:Environments:0:Key" value="DEV" />
    <add key="Turnover:Environments:0:DisplayName" value="Development" />
    <add key="Turnover:Environments:0:Tier" value="Dev" />
    <add key="Turnover:Environments:0:Host" value="IBMDEV01" />
    <add key="Turnover:Environments:0:ConnectionStringName" value="Db2Dev" />
    <add key="Turnover:Environments:0:LibrariesText" value="CUSTOMER=CUSDEV;ORDERS=ORDDEV;ORDPGM=ORDPGMDEV;ORDSRC=ORDSRCDEV" />
    <add key="Turnover:Environments:0:ProfilesText" value="ORDER_SVC=SVCORDDEV;SHIP_SVC=SVCSHPDEV;ORDER_GRP=ORDUSERS" />
    <add key="Turnover:Environments:0:IfsPathsText" value="WEB=/www/orders/dev" />

    <add key="Turnover:Environments:1:Key" value="QA" />
    <add key="Turnover:Environments:1:DisplayName" value="Quality Assurance" />
    <add key="Turnover:Environments:1:Tier" value="QA" />
    <add key="Turnover:Environments:1:Host" value="IBMDEV01" />
    <add key="Turnover:Environments:1:ConnectionStringName" value="Db2Qa" />
    <add key="Turnover:Environments:1:LibrariesText" value="CUSTOMER=CUSQA;ORDERS=ORDQA;ORDPGM=ORDPGMQA;ORDSRC=ORDSRCQA" />
    <add key="Turnover:Environments:1:ProfilesText" value="ORDER_SVC=SVCORDQA;SHIP_SVC=SVCSHPQA;ORDER_GRP=ORDUSERS" />
    <add key="Turnover:Environments:1:IfsPathsText" value="WEB=/www/orders/qa" />

    <add key="Turnover:Environments:2:Key" value="STAGE" />
    <add key="Turnover:Environments:2:DisplayName" value="Staging" />
    <add key="Turnover:Environments:2:Tier" value="Stage" />
    <add key="Turnover:Environments:2:Host" value="IBMSTG01" />
    <add key="Turnover:Environments:2:ConnectionStringName" value="Db2Stage" />
    <add key="Turnover:Environments:2:LibrariesText" value="CUSTOMER=CUSSTG;ORDERS=ORDSTG;ORDPGM=ORDPGMSTG;ORDSRC=ORDSRCSTG" />
    <add key="Turnover:Environments:2:ProfilesText" value="ORDER_SVC=SVCORDSTG;SHIP_SVC=SVCSHPSTG;ORDER_GRP=ORDUSERS" />
    <add key="Turnover:Environments:2:IfsPathsText" value="WEB=/www/orders/stg" />

    <add key="Turnover:Environments:3:Key" value="PROD" />
    <add key="Turnover:Environments:3:DisplayName" value="Production" />
    <add key="Turnover:Environments:3:Tier" value="Prod" />
    <add key="Turnover:Environments:3:Host" value="IBMPRD01" />
    <add key="Turnover:Environments:3:ConnectionStringName" value="Db2Prod" />
    <add key="Turnover:Environments:3:LibrariesText" value="CUSTOMER=CUSPRD;ORDERS=ORDPRD;ORDPGM=ORDPGMPRD;ORDSRC=ORDSRCPRD" />
    <add key="Turnover:Environments:3:ProfilesText" value="ORDER_SVC=SVCORDPRD;SHIP_SVC=SVCSHPPRD;ORDER_GRP=ORDUSERS" />
    <add key="Turnover:Environments:3:IfsPathsText" value="WEB=/www/orders/prd" />
    <!-- Deployments only inside these windows (server local time; a window may cross midnight). Outside them a release
         manager can schedule the package, or deploy as an emergency with a written justification. Empty = any time. -->
    <add key="Turnover:Environments:3:DeployWindows" value="Sat 22:00-02:00;Wed 21:00-23:59" />
    <!-- CL run around every deployment. "A => B": A runs first, B always runs at the end (also after a failure). Separate commands with |. -->
    <add key="Turnover:Environments:3:PreDeployCommands" value="HLDJOBQ JOBQ(QGPL/ORDJOBQ) => RLSJOBQ JOBQ(QGPL/ORDJOBQ)" />
    <add key="Turnover:Environments:3:PostDeployCommands" value="" />
    <!-- Other systems that receive this environment's deployments. Deploy = run the same approved script there;
         Verify = an HA product replicates, the tool only checks the objects arrived. Example: PRODDR:Deploy -->
    <add key="Turnover:Environments:3:DistributionText" value="PRODDR:Deploy" />

    <!-- Disaster-recovery partition. Same library names as Production (required for Deploy distribution). -->
    <add key="Turnover:Environments:4:Key" value="PRODDR" />
    <add key="Turnover:Environments:4:DisplayName" value="Production DR" />
    <add key="Turnover:Environments:4:Tier" value="Prod" />
    <add key="Turnover:Environments:4:Host" value="IBMDR01" />
    <add key="Turnover:Environments:4:ConnectionStringName" value="Db2ProdDr" />
    <add key="Turnover:Environments:4:LibrariesText" value="CUSTOMER=CUSPRD;ORDERS=ORDPRD;ORDPGM=ORDPGMPRD;ORDSRC=ORDSRCPRD" />
    <add key="Turnover:Environments:4:ProfilesText" value="ORDER_SVC=SVCORDPRD;SHIP_SVC=SVCSHPPRD;ORDER_GRP=ORDUSERS" />
    <add key="Turnover:Environments:4:IfsPathsText" value="WEB=/www/orders/prd" />
    <add key="Turnover:Environments:4:DeployWindows" value="Sat 22:00-02:00;Wed 21:00-23:59" />
    <add key="Turnover:Environments:4:PreDeployCommands" value="HLDJOBQ JOBQ(QGPL/ORDJOBQ) => RLSJOBQ JOBQ(QGPL/ORDJOBQ)" />

    <!-- Profiles compared by the same name everywhere (prefix* allowed). -->
    <add key="Turnover:TrackedProfilesText" value="" />

    <!-- Partition-wide objects compared between environments (names; prefix* allowed). System values are reported and
         only changed when ticked; security values (QSECURITY, QPWD*, ...) are never changed by a turnover. -->
    <add key="Turnover:TrackedSystemValuesText" value="QDATFMT;QCCSID;QMAXSIGN;QTIMZON" />
    <add key="Turnover:TrackedAuthorizationListsText" value="ORDAUTL" />
    <add key="Turnover:TrackedJobSchedulesText" value="ORD*" />
    <!-- IFS stream files larger than this (bytes) are compared by size only. -->
    <add key="Turnover:MaxIfsCompareBytes" value="5000000" />

    <!-- Which column each sequence feeds, so a sequence behind MAX(key) is caught. -->
    <add key="Turnover:SequenceBindings:0:Logical" value="ORDERS" />
    <add key="Turnover:SequenceBindings:0:Sequence" value="ORDER_SEQ" />
    <add key="Turnover:SequenceBindings:0:Table" value="ORDER_HEADER" />
    <add key="Turnover:SequenceBindings:0:Column" value="ORDER_ID" />
    <add key="Turnover:SequenceBindings:1:Logical" value="ORDERS" />
    <add key="Turnover:SequenceBindings:1:Sequence" value="AUDIT_SEQ" />
    <add key="Turnover:SequenceBindings:1:Table" value="ORDER_AUDIT" />
    <add key="Turnover:SequenceBindings:1:Column" value="AUDIT_ID" />

    <!-- Catalog reads and snapshot history. -->
    <add key="Turnover:Catalog:CacheMinutes" value="10" />
    <add key="Turnover:Catalog:MaxParallelLibraries" value="4" />
    <add key="Turnover:Catalog:CommandTimeoutSeconds" value="300" />
    <add key="Turnover:Catalog:HashSourceMembers" value="true" />
    <add key="Turnover:Snapshots:RetainPerEnvironment" value="60" />
    <add key="Turnover:Snapshots:CaptureOnCompare" value="true" />
    <add key="Turnover:Snapshots:AutoCaptureMinutes" value="0" />

    <!-- Source check-out: Required=true means a package may only carry source the requester has checked out.
         Check-outs are released when a package deploys to ReleaseOnTier (Dev, QA, Stage or Prod). -->
    <add key="Turnover:Checkout:Required" value="true" />
    <add key="Turnover:Checkout:ReleaseOnTier" value="Prod" />

    <!-- Background scheduler and deploy lock. -->
    <add key="Turnover:Scheduler:IntervalSeconds" value="60" />
    <add key="Turnover:DeployGateWaitSeconds" value="30" />

    <!-- Log files: one per day in this folder (relative = under the site). The app pool identity needs Modify rights on it;
         without them file logging switches off with a warning in the Windows event log. Startup failures are written to
         <Prefix>-startup-<date>.log in the same folder. -->
    <add key="Logging:File:Path" value="logs" />
    <add key="Logging:File:MinLevel" value="Information" />
    <add key="Logging:File:RetainDays" value="90" />
    <add key="Logging:File:Prefix" value="turnover" />

    <!-- Azure Key Vault. Enabled=true loads every secret (optionally only those starting with SecretPrefix). -->
    <add key="KeyVault:Enabled" value="false" />
    <add key="KeyVault:Uri" value="https://your-vault.vault.azure.net/" />
    <add key="KeyVault:TenantId" value="00000000-0000-0000-0000-000000000000" />
    <add key="KeyVault:ClientId" value="00000000-0000-0000-0000-000000000000" />
    <!-- One of: CertificateThumbprint (recommended), UseManagedIdentity=true, or ClientSecret (discouraged in this file). -->
    <add key="KeyVault:CertificateThumbprint" value="" />
    <add key="KeyVault:UseManagedIdentity" value="false" />
    <add key="KeyVault:SecretPrefix" value="" />
    <add key="KeyVault:ReloadMinutes" value="0" />

    <!-- Entra ID sign-in (Turnover:Auth:Mode=EntraId). The client secret comes from Key Vault (see the note at the top). -->
    <add key="AzureAd:Instance" value="https://login.microsoftonline.com/" />
    <add key="AzureAd:TenantId" value="00000000-0000-0000-0000-000000000000" />
    <add key="AzureAd:ClientId" value="00000000-0000-0000-0000-000000000000" />
    <add key="AzureAd:CallbackPath" value="/signin-oidc" />
  </appSettings>

  <connectionStrings>
    <!-- IBM i Access ODBC driver. No UID/PWD here: put the full connection string in Key Vault (see the note at the top). -->
    <add name="Db2Dev" connectionString="Driver={IBM i Access ODBC Driver};System=IBMDEV01;NAM=0;CMT=0;" />
    <add name="Db2Qa" connectionString="Driver={IBM i Access ODBC Driver};System=IBMDEV01;NAM=0;CMT=0;" />
    <add name="Db2Stage" connectionString="Driver={IBM i Access ODBC Driver};System=IBMSTG01;NAM=0;CMT=0;" />
    <add name="Db2Prod" connectionString="Driver={IBM i Access ODBC Driver};System=IBMPRD01;NAM=0;CMT=0;" />
    <add name="Db2ProdDr" connectionString="Driver={IBM i Access ODBC Driver};System=IBMDR01;NAM=0;CMT=0;" />
  </connectionStrings>

  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\IbmTurnover.Web.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <!-- Windows login: in IIS Manager, site > Authentication, enable Windows Authentication and disable Anonymous.
           (Those sections are locked at server level by default, so setting them here gives HTTP 500.19.)
           The app pool identity needs Modify rights on App_Data (packages and snapshot history are written there)
           and on logs (log files). -->
    </system.webServer>
  </location>
</configuration>
