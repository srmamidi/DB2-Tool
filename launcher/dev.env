# IBM i Turnover - DEV (shared development server, real IBM i Dev/QA partitions, Windows login)
# Loaded by run-dev.bat. KEY=VALUE per line; # starts a comment. No quotes.
# Environments, libraries, profiles and connection-string NAMES live in web.config (Turnover:Environments:n:*).
# Connection strings WITH credentials come from Key Vault (secret ConnectionStrings--Db2Dev, ...), never from here.
# The app refuses to start if anything required is missing (fail closed); the reason is written to the log folder.

# ---- Host -------------------------------------------------------------------------------------------
# Not "Development": that name enables the demo login and the developer error page.
ASPNETCORE_ENVIRONMENT=Dev
ASPNETCORE_URLS=http://localhost:5200
DOTNET_ROLL_FORWARD=Major
LAUNCH_MODE=run
LAUNCH_CONFIGURATION=Release
PUBLISH_DIR=

# ---- Turnover ---------------------------------------------------------------------------------------
Turnover__Mode=Live
Turnover__Auth__Mode=Windows
# AD groups for the three roles (Windows login refuses to start without all three).
Turnover__RoleGroups__Developer__0=CORP\TOV-Developers
Turnover__RoleGroups__Approver__0=CORP\TOV-Approvers
Turnover__RoleGroups__ReleaseManager__0=CORP\TOV-ReleaseManagers
Turnover__DataDirectory=App_Data
Turnover__ApprovalsRequired=1
Turnover__ProdApprovalsRequired=2
Turnover__AllowBlockerOverrideBelowProd=true
Turnover__Checkout__Required=true
Turnover__Checkout__ReleaseOnTier=QA
Turnover__Catalog__CacheMinutes=10
Turnover__Catalog__MaxParallelLibraries=4
Turnover__Catalog__CommandTimeoutSeconds=300
Turnover__Catalog__HashSourceMembers=true
Turnover__Snapshots__RetainPerEnvironment=60
Turnover__Snapshots__CaptureOnCompare=true
Turnover__Snapshots__AutoCaptureMinutes=0
Turnover__Scheduler__IntervalSeconds=60
# Seconds a deploy or rollback waits for another one to finish starting before it is refused (1-600).
Turnover__DeployGateWaitSeconds=30
Turnover__MaxIfsCompareBytes=5000000

# ---- Logging ----------------------------------------------------------------------------------------
Logging__File__Path=logs
Logging__File__MinLevel=Information
Logging__File__RetainDays=30
Logging__File__Prefix=turnover-dev
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

# ---- Azure Key Vault --------------------------------------------------------------------------------
KeyVault__Enabled=true
KeyVault__Uri=https://your-dev-vault.vault.azure.net/
KeyVault__TenantId=00000000-0000-0000-0000-000000000000
KeyVault__ClientId=00000000-0000-0000-0000-000000000000
# REQUIRED before run-dev.bat starts: a certificate thumbprint (LocalMachine\My) or UseManagedIdentity=true.
# As shipped neither is set here or in web.config, so the app refuses to start (fail closed) and says why in
# logs\turnover-dev-startup-<date>.log.
KeyVault__CertificateThumbprint=
KeyVault__UseManagedIdentity=false
KeyVault__SecretPrefix=Turnover-
KeyVault__ReloadMinutes=0
