# IBM i Turnover - LOCAL (your machine, sample data, demo users)
# Loaded by run-local.bat. KEY=VALUE per line; lines starting with # are comments. No quotes.
# Double underscore (__) is a configuration section separator: Turnover__Mode = Turnover:Mode.
# An empty value (KEY=) removes the variable, so web.config's value applies; it does not mean "empty".
# Environment variables override web.config; Azure Key Vault (when enabled) overrides both.
# NEVER put passwords, connection strings with UID/PWD, or client secrets in this file: use Key Vault.

# ---- Host -------------------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5199
# Only a newer .NET runtime installed? Major lets the .NET 8 app run on it. Servers should have the .NET 8 runtime.
DOTNET_ROLL_FORWARD=Major
# How to start: "run" builds and runs the project from source; "dll" runs a published build from PUBLISH_DIR.
LAUNCH_MODE=run
LAUNCH_CONFIGURATION=Debug
PUBLISH_DIR=

# ---- Turnover ---------------------------------------------------------------------------------------
# Sample = built-in demo catalog, nothing touches IBM i. Live = read and deploy over ODBC.
Turnover__Mode=Sample
# Demo (Development only) | Windows | EntraId
Turnover__Auth__Mode=Demo
Turnover__DataDirectory=App_Data
Turnover__ApprovalsRequired=1
Turnover__ProdApprovalsRequired=2
Turnover__AllowBlockerOverrideBelowProd=true
Turnover__Checkout__Required=true
Turnover__Checkout__ReleaseOnTier=Prod
Turnover__Catalog__CacheMinutes=10
Turnover__Catalog__MaxParallelLibraries=4
Turnover__Catalog__CommandTimeoutSeconds=300
Turnover__Catalog__HashSourceMembers=true
Turnover__Snapshots__RetainPerEnvironment=60
Turnover__Snapshots__CaptureOnCompare=true
Turnover__Snapshots__AutoCaptureMinutes=0
Turnover__Scheduler__IntervalSeconds=60
# Seconds a deploy or rollback waits for another one to finish starting before it is refused (1-600).
Turnover__DeployGateWaitSeconds=30
Turnover__MaxIfsCompareBytes=5000000

# ---- Logging ----------------------------------------------------------------------------------------
# Folder for daily log files (relative = under the web project). none = no file logging.
Logging__File__Path=logs
Logging__File__MinLevel=Information
Logging__File__RetainDays=14
Logging__File__Prefix=turnover-local
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

# ---- Azure Key Vault (off locally) ------------------------------------------------------------------
KeyVault__Enabled=false
KeyVault__Uri=
KeyVault__TenantId=
KeyVault__ClientId=
KeyVault__CertificateThumbprint=
KeyVault__UseManagedIdentity=false
KeyVault__SecretPrefix=Turnover-
KeyVault__ReloadMinutes=0
