# IBM i Turnover - PRODUCTION
# Normally the app runs under IIS, which reads web.config; put these same values on the IIS application pool
# (Configuration Editor > system.applicationHost/applicationPools > environmentVariables) or in web.config.
# run-prod.bat runs the PUBLISHED build with these values for a non-IIS host or a smoke test on the server.
# KEY=VALUE per line; # starts a comment. No quotes. No secrets: credentials come from Key Vault only.

# ---- Host -------------------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://localhost:5201
# Production servers carry the .NET 8 runtime: no roll-forward.
DOTNET_ROLL_FORWARD=
LAUNCH_MODE=dll
LAUNCH_CONFIGURATION=Release
# Folder that "dotnet publish src/IbmTurnover.Web -c Release -o <dir>" produced.
PUBLISH_DIR=D:\Sites\IbmTurnover

# ---- Turnover ---------------------------------------------------------------------------------------
Turnover__Mode=Live
Turnover__Auth__Mode=Windows
Turnover__RoleGroups__Developer__0=CORP\TOV-Developers
Turnover__RoleGroups__Approver__0=CORP\TOV-Approvers
Turnover__RoleGroups__ReleaseManager__0=CORP\TOV-ReleaseManagers
Turnover__DataDirectory=D:\Data\IbmTurnover
Turnover__ApprovalsRequired=1
Turnover__ProdApprovalsRequired=2
Turnover__AllowBlockerOverrideBelowProd=true
Turnover__Checkout__Required=true
Turnover__Checkout__ReleaseOnTier=Prod
Turnover__Catalog__CacheMinutes=10
Turnover__Catalog__MaxParallelLibraries=4
Turnover__Catalog__CommandTimeoutSeconds=300
Turnover__Catalog__HashSourceMembers=true
Turnover__Snapshots__RetainPerEnvironment=90
Turnover__Snapshots__CaptureOnCompare=true
Turnover__Snapshots__AutoCaptureMinutes=1440
Turnover__Scheduler__IntervalSeconds=60
# Seconds a deploy or rollback waits for another one to finish starting before it is refused (1-600).
Turnover__DeployGateWaitSeconds=30
Turnover__MaxIfsCompareBytes=5000000

# ---- Logging ----------------------------------------------------------------------------------------
Logging__File__Path=D:\Logs\IbmTurnover
Logging__File__MinLevel=Information
Logging__File__RetainDays=90
Logging__File__Prefix=turnover-prod
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

# ---- Azure Key Vault --------------------------------------------------------------------------------
KeyVault__Enabled=true
KeyVault__Uri=https://your-prod-vault.vault.azure.net/
KeyVault__TenantId=00000000-0000-0000-0000-000000000000
KeyVault__ClientId=00000000-0000-0000-0000-000000000000
KeyVault__CertificateThumbprint=
KeyVault__UseManagedIdentity=false
KeyVault__SecretPrefix=Turnover-
KeyVault__ReloadMinutes=60
